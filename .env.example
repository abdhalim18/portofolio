# Salin file ini menjadi .env.local lalu isi nilainya. Jangan commit .env.local.

# Musik (Spotify -> Last.fm): https://www.last.fm/api/account/create
# Hubungkan Spotify di https://www.last.fm/settings/applications agar lagu Spotify tercatat.
LASTFM_API_KEY=
LASTFM_USERNAME=

# Olahraga (jam Amazfit -> Zepp -> Intervals.icu): https://intervals.icu/settings
# Hubungkan Amazfit di Settings, lalu buat API key di bagian "Developer Settings".
INTERVALS_API_KEY=
